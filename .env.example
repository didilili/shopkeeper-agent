# 复制为 .env，仅用于本地开发。不要提交真实密钥。
APP_ENV=development
APP_NAME=shopkeeper-agent

# 日志
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=INFO
LOG_FILE_PATH=logs
LOG_ROTATION=10 MB
LOG_RETENTION=7 days

# 元数据 MySQL
DB_META_HOST=127.0.0.1
DB_META_PORT=3306
DB_META_USER=didilili
DB_META_PASSWORD=dili123
DB_META_NAME=meta
DB_META_POOL_SIZE=10
DB_META_MAX_OVERFLOW=20
DB_META_POOL_RECYCLE=1800
DB_META_CONNECT_TIMEOUT=10

# 数仓 MySQL（生产环境建议使用独立只读账号）
DB_DW_HOST=127.0.0.1
DB_DW_PORT=3306
DB_DW_USER=didilili
DB_DW_PASSWORD=dili123
DB_DW_NAME=dw
DB_DW_POOL_SIZE=10
DB_DW_MAX_OVERFLOW=20
DB_DW_POOL_RECYCLE=1800
DB_DW_CONNECT_TIMEOUT=10

# Qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024
QDRANT_API_KEY=
QDRANT_TIMEOUT=10

# Embedding
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_TIMEOUT=30

# Elasticsearch
ES_SCHEME=http
ES_HOST=127.0.0.1
ES_PORT=9200
ES_INDEX_NAME=data_agent
ES_USERNAME=
ES_PASSWORD=
ES_REQUEST_TIMEOUT=30

# 多路召回与融合重排
RETRIEVAL_MAX_CONCURRENCY=8
RETRIEVAL_MAX_QUERIES=12
COLUMN_RETRIEVAL_SCORE_THRESHOLD=0.6
COLUMN_RETRIEVAL_PER_QUERY_LIMIT=20
COLUMN_RETRIEVAL_FINAL_LIMIT=20
COLUMN_RETRIEVAL_RRF_K=60
COLUMN_RETRIEVAL_EXACT_BOOST=0.05
METRIC_RETRIEVAL_SCORE_THRESHOLD=0.6
METRIC_RETRIEVAL_PER_QUERY_LIMIT=20
METRIC_RETRIEVAL_FINAL_LIMIT=10
METRIC_RETRIEVAL_RRF_K=60
METRIC_RETRIEVAL_EXACT_BOOST=0.05
VALUE_RETRIEVAL_SCORE_THRESHOLD=0.6
VALUE_RETRIEVAL_PER_QUERY_LIMIT=20
VALUE_RETRIEVAL_FINAL_LIMIT=20
VALUE_RETRIEVAL_RRF_K=60
VALUE_RETRIEVAL_EXACT_BOOST=0.05

# Agent SQL 安全执行边界
SQL_MAX_LENGTH=12000
SQL_MAX_RESULT_ROWS=1000
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_CORRECTION_ATTEMPTS=2

# 模型注册表与凭证
# MODEL_REGISTRY_PATH 默认使用 config/models.yaml，部署时可替换为其他注册表文件。
MODEL_REGISTRY_PATH=
LLM_API_KEY=your_api_key_here
